    <name>XL Converter</name>
    <summary>Convert images</summary>
    <description>
        <p>XL Converter is an easy-to-use image converter for modern formats.</p>
        <ul>
            <li>Batch transcode images to JPEG XL, AVIF, WebP, JPEG and PNG.</li>
            <li>Preserve high quality at a modest size with JPEG XL and AVIF.</li>
            <li>Encode better quality JPEG images with JPEGLI.</li>
            <li>Losslessly recompress your JPEG images.</li>
            <li>Convert faster with parallel encoding.</li>
            <li>Preserve metadata with ExifTool.</li>
            <li>Scale down images.</li>
            <li>QoL features available: drag 'n drop, dark theme, keep directory structure, copy smaller sources, and more.</li>
        </ul>
    </description>
    <launchable type="desktop-id">eu.codepoems.xl-converter.desktop</launchable>
    <icon type="stock">eu.codepoems.xl-converter</icon>
    <branding>
        <color type="primary" scheme_preference="light">#5ebf82</color>
        <color type="primary" scheme_preference="dark">#0b6939</color>
    </branding>
    <content_rating type="oars-1.1" />
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
    </recommends>
    <requires>
        <display_length compare="ge">768</display_length>
    </requires>
    <provides>
        <mediatype>image/png</mediatype>
        <mediatype>image/jpeg</mediatype>
        <mediatype>image/jxl</mediatype>
        <mediatype>image/avif</mediatype>
        <mediatype>image/bmp</mediatype>
        <mediatype>image/gif</mediatype>
        <mediatype>image/apng</mediatype>
        <mediatype>image/jp2</mediatype>
        <mediatype>image/webp</mediatype>
    </provides>
    <categories>
        <category>Graphics</category>
        <category>ImageProcessing</category>
    </categories>
    <keywords>
        <keyword>image</keyword>
        <keyword>converter</keyword>
        <keyword>jpeg xl</keyword>
    </keywords>

